{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage_summary",
    "current_subtask_template",
    "points",
    "new_keyframes"
  ],
  "properties": {
    "stage_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "current_subtask_template": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "points": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "object_description",
          "source_frame_id",
          "x_norm",
          "y_norm"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "point_1",
              "point_2"
            ]
          },
          "object_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "source_frame_id": {
            "type": "string",
            "pattern": "^r_f[0-9]+$"
          },
          "x_norm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "y_norm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          }
        }
      }
    },
    "new_keyframes": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame_id",
          "description",
          "reason"
        ],
        "properties": {
          "frame_id": {
            "type": "string",
            "pattern": "^r_[fw][0-9]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    }
  }
}
