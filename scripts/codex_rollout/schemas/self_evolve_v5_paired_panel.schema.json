{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "panel_id", "panel_role", "task", "problem_id", "samples"],
  "properties": {
    "schema_version": {"const": "self-evolve-v5-paired-panel-v1"},
    "panel_id": {"type": "string", "minLength": 1},
    "panel_role": {"enum": ["development", "generalization"]},
    "task": {"type": "string", "minLength": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_split", "episode_id", "baseline_success"],
        "properties": {
          "dataset_split": {"enum": ["train", "val"]},
          "episode_id": {"type": "integer", "minimum": 0},
          "baseline_success": {"type": "boolean"}
        }
      }
    }
  }
}
