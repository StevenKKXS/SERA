{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["dataset_split", "episode_id", "outcome"],
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "failure"}}},
      "then": {
        "required": ["task_variant", "failure_stage", "primary_problem", "first_divergence", "secondary_symptoms", "responsible_module", "runtime_observable", "planner_actionability", "confidence", "causal_chain"],
        "properties": {
          "causal_chain": {
            "type": "object",
            "additionalProperties": false,
            "required": ["physical_first_divergence", "task_progress_divergence", "terminal_failure", "causal_link_evidence"],
            "properties": {
              "physical_first_divergence": {"type": "string", "minLength": 1},
              "task_progress_divergence": {"type": "string", "minLength": 1},
              "terminal_failure": {"type": "string", "minLength": 1},
              "causal_link_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  ]
}
