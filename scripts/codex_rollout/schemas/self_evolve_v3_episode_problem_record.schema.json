{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "self-evolve-v3-episode-problem-record-v1",
  "title": "Self-evolve v3 episode problem record",
  "type": "object",
  "required": [
    "dataset_split",
    "episode_id",
    "outcome"
  ],
  "properties": {
    "dataset_split": {
      "enum": ["train", "val"]
    },
    "episode_id": {
      "type": "integer",
      "minimum": 0
    },
    "outcome": {
      "enum": ["success", "failure"]
    },
    "task_variant": {
      "type": "string",
      "minLength": 1
    },
    "failure_stage": {
      "type": "string",
      "minLength": 1
    },
    "primary_problem": {
      "type": "string",
      "minLength": 1
    },
    "first_divergence": {
      "type": "string",
      "minLength": 1
    },
    "secondary_symptoms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "responsible_module": {
      "type": "string",
      "minLength": 1
    },
    "runtime_observable": {
      "type": "boolean"
    },
    "planner_actionability": {
      "oneOf": [
        {
          "enum": ["none", "low", "partial", "high", "full"]
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "counterexample_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "estimated_episode_gain": {
      "type": "number",
      "minimum": 0
    },
    "regression_risk": {
      "type": "number",
      "minimum": 0
    },
    "experiment_cost": {
      "type": "number",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "failure"
          }
        }
      },
      "then": {
        "required": [
          "task_variant",
          "failure_stage",
          "primary_problem",
          "first_divergence",
          "secondary_symptoms",
          "responsible_module",
          "runtime_observable",
          "planner_actionability",
          "confidence"
        ]
      }
    }
  ],
  "additionalProperties": true
}
